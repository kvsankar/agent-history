#!/usr/bin/env python3
"""
claude-history - Backward compatibility wrapper for cagelens

This script provides backward compatibility for users who have scripts or
muscle memory using 'claude-history'. It simply forwards all arguments to
'cagelens'.
"""

import subprocess
import sys
from pathlib import Path

# Find cagelens in the same directory as this script
script_dir = Path(__file__).resolve().parent
cagelens = script_dir / "cagelens"

if not cagelens.exists():
    sys.stderr.write(f"Error: cagelens not found at {cagelens}\n")
    sys.exit(1)

# Execute cagelens with the same arguments
# Use subprocess.run instead of os.execv for Windows compatibility (handles paths with spaces)
result = subprocess.run(
    [sys.executable, str(cagelens), *sys.argv[1:]],
    check=False,
)
sys.exit(result.returncode)
