#!/usr/bin/env python3
"""Backward compatibility wrapper for cagelens.

The project was previously invoked as ``agent-history``. Keep this script so
existing shell history, docs, and automation can continue to run while the
primary command moves to ``cagelens``.
"""

import subprocess
import sys
from pathlib import Path

script_dir = Path(__file__).resolve().parent
cagelens = script_dir / "cagelens"

if not cagelens.exists():
    sys.stderr.write(f"Error: cagelens not found at {cagelens}\n")
    sys.exit(1)

result = subprocess.run(
    [sys.executable, str(cagelens), *sys.argv[1:]],
    check=False,
)
sys.exit(result.returncode)
